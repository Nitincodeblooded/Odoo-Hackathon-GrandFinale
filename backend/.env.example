NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/peoplepay360?retryWrites=true&w=majority&appName=PeoplePay360
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Used only by `npm run seed:admin`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-secure-password
ADMIN_EMPLOYEE_NUMBER=EMP-001
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Administrator

# Payslip email delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=PeoplePay360 Payroll <payroll@example.com>
